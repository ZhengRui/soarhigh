# Use absolute paths. Create both directories before starting Hermes.
HERMES_HOME_DIR=/absolute/path/to/.hermes
HERMES_WORKSPACE_DIR=/absolute/path/to/hermes-workspace

# Pin this to a tested release tag when the deployment is stabilized.
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_CONTAINER_NAME=soarhigh-hermes
