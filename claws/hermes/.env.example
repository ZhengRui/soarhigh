# Use absolute paths. Create both directories before starting Hermes.
HERMES_HOME_DIR=/absolute/path/to/.hermes
HERMES_WORKSPACE_DIR=/absolute/path/to/hermes-workspace

# Pin this to a tested release tag when the deployment is stabilized.
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_CONTAINER_NAME=soarhigh-hermes

# Used by the workspace controller to validate ArticleDocument through the
# backend-owned protocol endpoint. From Docker Desktop, the host backend is:
SOARHIGH_API_BASE_URL=http://host.docker.internal:5000
WXPOST_PREVIEW_BROWSER_BASE_URL=http://host.docker.internal:3000

# Use the same value as backend/.env's existing WXPOST_SERVICE_TOKEN.
SOARHIGH_WXPOST_SERVICE_TOKEN=
TAVILY_API_KEY=
